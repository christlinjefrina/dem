CREATE OR REPLACE FUNCTION TOP_CUSTOMER(
    P_TYPE IN VARCHAR2
)
RETURN VARCHAR2
IS
    V_NAME VARCHAR2(30);
BEGIN
    SELECT C.CUST_NAME
    INTO V_NAME
    FROM CUSTOMER C, ORDERS O, ORDER_LIST OL, PIZZA P
    WHERE C.CUST_ID = O.CUST_ID
    AND O.ORDER_NO = OL.ORDER_NO
    AND OL.PIZZA_ID = P.PIZZA_ID
    AND P.PIZZA_TYPE = P_TYPE
    AND ROWNUM = 1;

    RETURN V_NAME;
END;
/

SELECT TOP_CUSTOMER('pan') FROM DUAL;


