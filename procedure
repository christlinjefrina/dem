CREATE OR REPLACE PROCEDURE BILL(
    P_ORDERNO IN VARCHAR2
)
IS
    V_TOTAL NUMBER;
BEGIN
    SELECT SUM(OL.QTY * P.UNIT_PRICE)
    INTO V_TOTAL
    FROM ORDER_LIST OL, PIZZA P
    WHERE OL.PIZZA_ID = P.PIZZA_ID
    AND OL.ORDER_NO = P_ORDERNO;

    UPDATE ORDERS
    SET TOTAL_AMT = V_TOTAL
    WHERE ORDER_NO = P_ORDERNO;

    DBMS_OUTPUT.PUT_LINE('Total Bill = ' || V_TOTAL);
END;
/

EXEC BILL('OP100');

SELECT * FROM ORDERS;


