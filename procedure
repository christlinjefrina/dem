SET SERVEROUTPUT ON;

CREATE OR REPLACE PROCEDURE TOTAL_PIZZA (
    P_ORDERNO IN VARCHAR2,
    P_TOTAL OUT NUMBER
)
IS
BEGIN
    SELECT NVL(SUM(QTY), 0)
    INTO P_TOTAL
    FROM ORDER_LIST
    WHERE ORDER_NO = P_ORDERNO;

    IF P_TOTAL = 0 THEN
        DBMS_OUTPUT.PUT_LINE('No pizzas found');
    ELSE
        DBMS_OUTPUT.PUT_LINE(
            'Total pizzas ordered = ' || P_TOTAL
        );
    END IF;
END;
/

VARIABLE X NUMBER;
EXEC TOTAL_PIZZA('OP100', :X);
PRINT X;


