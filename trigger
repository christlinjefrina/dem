CREATE OR REPLACE TRIGGER T1
BEFORE INSERT OR UPDATE ON ORDERS
FOR EACH ROW
BEGIN
    IF :NEW.DELV_DATE > :NEW.ORDER_DATE + 1 THEN
        RAISE_APPLICATION_ERROR(-20001, 'Invalid delivery date');
    END IF;
END;
/



CREATE OR REPLACE TRIGGER T2
AFTER INSERT ON ORDER_LIST
FOR EACH ROW
DECLARE
    P NUMBER;
BEGIN
    SELECT UNIT_PRICE INTO P
    FROM PIZZA
    WHERE PIZZA_ID = :NEW.PIZZA_ID;

    UPDATE ORDERS
    SET TOTAL_AMT = NVL(TOTAL_AMT,0) + P * :NEW.QTY
    WHERE ORDER_NO = :NEW.ORDER_NO;
END;
/


CREATE OR REPLACE TRIGGER T3
BEFORE INSERT ON ORDERS
FOR EACH ROW
DECLARE
    C NUMBER;
BEGIN
    SELECT COUNT(*) INTO C
    FROM ORDERS
    WHERE CUST_ID = :NEW.CUST_ID
    AND TRUNC(ORDER_DATE) = TRUNC(:NEW.ORDER_DATE);

    IF C >= 5 THEN
        RAISE_APPLICATION_ERROR(-20002, 'Maximum 5 orders allowed');
    END IF;
END;
/



